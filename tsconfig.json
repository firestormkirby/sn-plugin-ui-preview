{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "react-native": ["./src/mocks/react-native.ts"],
      "sn-plugin-lib": ["./src/mocks/sn-plugin-lib.ts"],
      "react-native-fs": ["./src/mocks/react-native-fs.ts"],
      "@react-native-async-storage/async-storage": ["./src/mocks/async-storage.ts"]
    }
  },
  "include": ["src", "example", "preview.config.tsx", "vite.config.ts"]
}
